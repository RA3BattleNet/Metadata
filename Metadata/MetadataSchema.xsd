<?xml version="1.0" encoding="UTF-8"?>
<!-- 源树 schema：多文件 + Include。核心构建时对源目录全部 .xml 硬校验。 -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:element name="Metadata" type="MetadataRootType"/>

  <xs:complexType name="MetadataRootType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Tags" type="TagsType"/>
      <xs:element name="Includes" type="IncludesType"/>
      <xs:element name="Application" type="ApplicationType"/>
      <xs:element name="Mod" type="ModType"/>
      <xs:element name="Base" type="BaseType"/>
      <xs:element name="Markdown" type="MarkdownRegType"/>
      <xs:element name="Image" type="ImageRegType"/>
      <xs:element name="Manifest" type="ManifestFullType"/>
    </xs:choice>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>

  <!-- 源树专用：构建期合并进 Mod/Application 后删除，不进发布物 -->
  <xs:complexType name="BaseType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Version" type="xs:string"/>
      <xs:element name="CurrentVersion" type="xs:string"/>
      <xs:element name="Icon" type="xs:string"/>
      <xs:element name="Style" type="StyleType"/>
      <xs:element name="Packages" type="PackagesType"/>
      <xs:element name="Settings" type="ModSettingsType"/>
    </xs:choice>
    <xs:attribute name="ID" type="xs:string" use="required"/>
    <xs:attribute name="Kind" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="Mod"/>
          <xs:enumeration value="Application"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="TagsType">
    <xs:sequence>
      <xs:element name="Commit" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="IncludesType">
    <xs:sequence>
      <xs:element name="Include" type="IncludeType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="IncludeType">
    <xs:attribute name="Source" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="ApplicationType">
    <xs:sequence>
      <xs:element name="Version" type="xs:string" minOccurs="0"/>
      <xs:element name="Packages" type="PackagesType" minOccurs="0"/>
      <xs:element name="Posts" type="PostsType" minOccurs="0"/>
      <xs:element name="UpdateKind" type="UpdateKindType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="ID" type="xs:string" use="required"/>
    <xs:attribute name="InheritFrom" type="xs:string"/>
  </xs:complexType>

  <!-- 更新线：客户端据此定位"当前该用哪份更新器清单"及资源地址。
       Current = 目标版本，必须对应下面某条 Updater@Version（客户端只做等值查找，不比较版本号）。
       BaseUrl / FallbackBaseUrl = 资源（files/、patches/）主备地址，与清单地址互相独立。 -->
  <xs:complexType name="UpdateKindType">
    <xs:sequence>
      <xs:element name="Updater" type="UpdaterType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="ID" type="xs:string" use="required"/>
    <xs:attribute name="DisplayName" type="xs:string"/>
    <xs:attribute name="Current" type="xs:string"/>
    <xs:attribute name="BaseUrl" type="xs:string"/>
    <xs:attribute name="FallbackBaseUrl" type="xs:string"/>
  </xs:complexType>

  <!-- 一条已发布的更新器清单记录：Source 是清单地址（绝对或相对），
       Hash/Size 描述清单文件本身的字节（清单内部的文件哈希由 Updater 负责，是另一回事）。 -->
  <xs:complexType name="UpdaterType">
    <xs:attribute name="Version" type="xs:string" use="required"/>
    <xs:attribute name="Source" type="xs:string" use="required"/>
    <xs:attribute name="Hash" type="xs:string"/>
    <xs:attribute name="Size" type="xs:string"/>
    <xs:attribute name="ReleaseDate" type="xs:string"/>
    <xs:attribute name="Commit" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="ModType">
    <xs:sequence>
      <xs:element name="CurrentVersion" type="xs:string" minOccurs="0"/>
      <xs:element name="Icon" type="xs:string" minOccurs="0"/>
      <xs:element name="DisplayName" type="LocalizedTextType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Style" type="StyleType" minOccurs="0"/>
      <xs:element name="Packages" type="PackagesType" minOccurs="0"/>
      <xs:element name="Posts" type="PostsType" minOccurs="0"/>
      <xs:element name="Links" type="LinksType" minOccurs="0"/>
      <xs:element name="Settings" type="ModSettingsType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="ID" type="xs:string" use="required"/>
    <xs:attribute name="InheritFrom" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="LinksType">
    <xs:sequence>
      <xs:element name="Link" type="LinkType" minOccurs="0" maxOccurs="unbounded">
        <xs:unique name="UniqueLinkDisplayNameLanguage">
          <xs:selector xpath="DisplayName"/>
          <xs:field xpath="@Language"/>
        </xs:unique>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="LinkType">
    <xs:sequence>
      <xs:element name="Icon" type="xs:string" minOccurs="0"/>
      <xs:element name="DisplayName" type="LocalizedTextType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="Url" type="HttpUrlType" use="required"/>
    <xs:attribute name="Languages" type="LanguageListType"/>
  </xs:complexType>

  <xs:simpleType name="HttpUrlType">
    <xs:restriction base="xs:string">
      <xs:whiteSpace value="preserve"/>
      <xs:pattern value="[hH][tT][tT][pP][sS]?://[^\s/?#]+(/[^\s]*)?(\?[^\s]*)?(#[^\s]*)?"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LanguageListType">
    <xs:restriction>
      <xs:simpleType>
        <xs:list itemType="xs:language"/>
      </xs:simpleType>
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Languages 缺省时所有语言可见；zh/en 匹配自身及 zh-*/en-*，地区标签仅精确匹配；比较不区分大小写，en 不匹配 english。名称精确匹配当前语言，缺少时取第一条。客户端负责筛选。 -->
  <!-- Links 只允许 Mod 直接配置，文档顺序就是展示顺序；Icon 是已登记 Image 的短 ID，省略时显示通用外链图标。XSD 仅限制 URL 格式，不检查可访问性或跨 Include 的 Icon 类型／存在性。 -->

  <xs:complexType name="StyleType">
    <xs:sequence>
      <xs:element name="Logo" type="LogoType" minOccurs="0"/>
      <xs:element name="Controls" type="ControlsType" minOccurs="0"/>
      <xs:element name="Background" type="BackgroundType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="PositiveLengthType">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonNegativeLengthType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FontWeightType">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="100"/>
      <xs:maxInclusive value="900"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LogoPositionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="TopLeft"/>
      <xs:enumeration value="TopCenter"/>
      <xs:enumeration value="TopRight"/>
      <xs:enumeration value="CenterLeft"/>
      <xs:enumeration value="Center"/>
      <xs:enumeration value="CenterRight"/>
      <xs:enumeration value="BottomLeft"/>
      <xs:enumeration value="BottomCenter"/>
      <xs:enumeration value="BottomRight"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="LogoType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="Width" type="PositiveLengthType"/>
        <xs:attribute name="Height" type="PositiveLengthType"/>
        <xs:attribute name="Position" type="LogoPositionType"/>
        <xs:attribute name="OffsetX" type="xs:decimal"/>
        <xs:attribute name="OffsetY" type="xs:decimal"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:simpleType name="HexColorType">
    <xs:restriction base="xs:string">
      <xs:pattern value="#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ColorFormatType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="CSS"/>
      <xs:enumeration value="ARGB"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Format 缺省为 CSS；ARGB 的八位长度由 SchemaValidator 关联校验。 -->
  <xs:complexType name="ColorType">
    <xs:simpleContent>
      <xs:extension base="HexColorType">
        <xs:attribute name="Format" type="ColorFormatType"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="ControlsType">
    <xs:all>
      <xs:element name="PrimaryLabel" type="LabelStyleType" minOccurs="0"/>
      <xs:element name="SecondaryLabel" type="LabelStyleType" minOccurs="0"/>
      <xs:element name="PrimaryButton" type="ButtonStyleType" minOccurs="0"/>
      <xs:element name="SecondaryButton" type="ButtonStyleType" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="LabelStyleType">
    <xs:all>
      <xs:element name="Color" type="ColorType" minOccurs="0"/>
      <xs:element name="FontSize" type="PositiveLengthType" minOccurs="0"/>
      <xs:element name="FontWeight" type="FontWeightType" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="ButtonStateType">
    <xs:all>
      <xs:element name="BorderColor" type="ColorType" minOccurs="0"/>
      <xs:element name="BorderWidth" type="NonNegativeLengthType" minOccurs="0"/>
      <xs:element name="BackgroundColor" type="ColorType" minOccurs="0"/>
      <xs:element name="Color" type="ColorType" minOccurs="0"/>
      <xs:element name="FontSize" type="PositiveLengthType" minOccurs="0"/>
      <xs:element name="FontWeight" type="FontWeightType" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="ButtonStyleType">
    <xs:all>
      <xs:element name="BorderColor" type="ColorType" minOccurs="0"/>
      <xs:element name="BorderWidth" type="NonNegativeLengthType" minOccurs="0"/>
      <xs:element name="BackgroundColor" type="ColorType" minOccurs="0"/>
      <xs:element name="Color" type="ColorType" minOccurs="0"/>
      <xs:element name="FontSize" type="PositiveLengthType" minOccurs="0"/>
      <xs:element name="FontWeight" type="FontWeightType" minOccurs="0"/>
      <xs:element name="Hover" type="ButtonStateType" minOccurs="0"/>
      <xs:element name="Active" type="ButtonStateType" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <!-- Image 是登记图片的 ID 文本引用，不是图片登记节点。 -->
  <xs:complexType name="BackgroundType">
    <xs:sequence>
      <xs:element name="Image" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Color" type="ColorType" minOccurs="0"/>
      <xs:element name="SecondaryColor" type="ColorType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="Random" type="xs:boolean"/>
  </xs:complexType>

  <xs:complexType name="PackagesType">
    <xs:sequence>
      <xs:element name="Package" type="PackageType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PackageType">
    <xs:sequence>
      <xs:element name="ReleaseDate" type="xs:string" minOccurs="0"/>
      <!-- 文本为 Manifest 登记 ID -->
      <xs:element name="Manifest" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="Version" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="LocalizedTextType" mixed="true">
    <xs:attribute name="Language" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- 新设置动态文案：Language 为标准语言族（zh/en，可扩展其它 ISO 主语言族），地区标签仅用于既有 links/posts。 -->
  <xs:complexType name="SettingTextType" mixed="true">
    <xs:attribute name="Language" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- 通用模组设置定义：仅布尔与单选枚举；ID 为 Mod 内局部 ID，不参与全根资源前缀 -->
  <xs:complexType name="ModSettingsType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Boolean" type="BooleanSettingType"/>
      <xs:element name="Choice" type="ChoiceSettingType"/>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="BooleanSettingType">
    <xs:sequence>
      <xs:element name="DisplayName" type="SettingTextType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Description" type="SettingTextType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="ID" type="xs:string" use="required"/>
    <xs:attribute name="Default" type="xs:boolean" use="required"/>
  </xs:complexType>

  <xs:complexType name="ChoiceSettingType">
    <xs:sequence>
      <xs:element name="DisplayName" type="SettingTextType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Description" type="SettingTextType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Option" type="SettingOptionType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="ID" type="xs:string" use="required"/>
    <xs:attribute name="Default" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="SettingOptionType">
    <xs:sequence>
      <xs:element name="DisplayName" type="SettingTextType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Description" type="SettingTextType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="Value" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- 无条件注入动作：空节点是显式新执行机制标记 -->
  <xs:complexType name="InjectionType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="RequireDll" type="DllRefType"/>
      <xs:element name="InjectDll" type="DllRefType"/>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="DllRefType">
    <xs:attribute name="Ref" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- 版本清单设置绑定：全部引用语法，禁止用 ID 冒充定义 -->
  <xs:complexType name="ManifestSettingsType">
    <xs:sequence>
      <xs:element name="SettingRef" type="SettingRefType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SettingRefType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="MountPackage" type="MountPackageType"/>
      <xs:element name="MountLanguage" type="EmptyType"/>
      <xs:element name="InjectDll" type="DllRefType"/>
      <xs:element name="ConfigureLuaBridge" type="ConfigureLuaBridgeType"/>
      <xs:element name="Case" type="SettingCaseType"/>
    </xs:choice>
    <xs:attribute name="Ref" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="SettingCaseType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="MountPackage" type="MountPackageType"/>
      <xs:element name="MountLanguage" type="EmptyType"/>
      <xs:element name="InjectDll" type="DllRefType"/>
      <xs:element name="ConfigureLuaBridge" type="ConfigureLuaBridgeType"/>
    </xs:choice>
    <xs:attribute name="Value" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="MountPackageType">
    <xs:attribute name="Name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="ConfigureLuaBridgeType">
    <xs:attribute name="Ref" type="xs:string" use="required"/>
    <xs:attribute name="Adapter" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="EmptyType"/>

  <!-- DLL 声明的类型化运行参数；当前仅 utf8/log-file -->
  <xs:complexType name="DllCustomDataType">
    <xs:sequence>
      <xs:element name="RuntimeValue" type="RuntimeValueType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="Encoding" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="RuntimeValueType">
    <xs:attribute name="Name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="PostsType">
    <xs:sequence>
      <xs:element name="Post" type="PostType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PostType">
    <xs:sequence>
      <xs:element name="Titles" type="TitlesType"/>
      <xs:element name="Descriptions" type="DescriptionsType" minOccurs="0"/>
      <xs:element name="Contents" type="ContentsType"/>
    </xs:sequence>
    <xs:attribute name="DateTime" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DescriptionsType">
    <xs:sequence>
      <xs:element name="Description" type="LocalizedTextType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TitlesType">
    <xs:sequence>
      <xs:element name="Title" type="LocalizedTextType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ContentsType">
    <xs:sequence>
      <xs:element name="Content" type="LocalizedTextType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MarkdownRegType">
    <xs:attribute name="ID" type="xs:string" use="required"/>
    <xs:attribute name="Source" type="xs:string" use="required"/>
    <xs:attribute name="Hash" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="ImageRegType">
    <xs:attribute name="ID" type="xs:string" use="required"/>
    <xs:attribute name="Source" type="xs:string"/>
    <xs:attribute name="Url" type="xs:string"/>
    <xs:attribute name="Hash" type="xs:string"/>
  </xs:complexType>

  <!-- 源侧叶子清单：含 File 表（Updater 生成）；HashAlgorithm 缺省按 CRC32C。
       Skudef 声明挂载顺序与加载条件，写在 File 表前面；写了 Skudef 就不能再在 File 上写 Mount/Language/Package -->
  <xs:complexType name="ManifestFullType">
    <xs:sequence>
      <xs:element name="Skudef" type="SkudefType" minOccurs="0"/>
      <xs:element name="File" type="FileType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Dependencies" type="DependenciesType" minOccurs="0"/>
      <xs:element name="Injection" type="InjectionType" minOccurs="0"/>
      <xs:element name="Settings" type="ManifestSettingsType" minOccurs="0"/>
      <xs:element name="SubManifest" type="SubManifestType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="ID" type="xs:string" use="required"/>
    <xs:attribute name="HashAlgorithm" type="HashAlgorithmType"/>
  </xs:complexType>

  <!-- 客户端 skudef 的声明：子元素顺序就是 skudef 里的行顺序；GameVersion 缺省 1.12 -->
  <xs:complexType name="SkudefType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="AddBig" type="AddBigType"/>
      <xs:element name="AddConfig" type="AddConfigType"/>
    </xs:choice>
    <xs:attribute name="GameVersion" type="xs:string"/>
  </xs:complexType>

  <!-- 挂载清单里的一个文件；Language/Package 是加载条件，不写就是总是挂；两者只能写一个 -->
  <xs:complexType name="AddBigType">
    <xs:attribute name="File" type="xs:string" use="required"/>
    <xs:attribute name="Language" type="xs:string"/>
    <xs:attribute name="Package" type="xs:string"/>
  </xs:complexType>

  <!-- 挂载模组目录下用户自己放的文件；LocalFile 必须是纯文件名（不带路径） -->
  <xs:complexType name="AddConfigType">
    <xs:attribute name="LocalFile" type="xs:string" use="required"/>
    <xs:attribute name="Optional" type="xs:boolean"/>
  </xs:complexType>

  <xs:simpleType name="HashAlgorithmType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="CRC32C"/>
      <xs:enumeration value="MD5"/>
      <xs:enumeration value="SHA256"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- FileName 是安装名（解压后的名字），DownloadName 是下载物的服务端文件名（缺省等于 FileName）；
       Hash 描述解压后的安装文件（FileName），Size 描述下载物（DownloadName 对应的字节）；
       Compression 表示校验通过后解压成 FileName -->
  <xs:complexType name="FileType">
    <xs:sequence>
      <xs:element name="FileName" type="xs:string"/>
      <xs:element name="RelativePath" type="xs:string"/>
      <xs:element name="KindOf" type="xs:string"/>
      <xs:element name="Sources" type="SourcesType" minOccurs="0"/>
      <xs:element name="PatchInfo" type="PatchInfoType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="Hash" type="xs:string" use="required"/>
    <xs:attribute name="Size" type="xs:long"/>
    <xs:attribute name="DownloadName" type="xs:string"/>
    <xs:attribute name="Compression" type="CompressionType"/>
    <!-- Mount 缺省 base。language 必填 Language，optional 必填 Package；base 不能带这两个属性。取值由构建期校验 -->
    <xs:attribute name="Mount" type="xs:string"/>
    <xs:attribute name="Language" type="xs:string"/>
    <xs:attribute name="Package" type="xs:string"/>
  </xs:complexType>

  <xs:simpleType name="CompressionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="zstd"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="SourcesType">
    <xs:sequence>
      <xs:element name="Source" type="SourceType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SourceType">
    <xs:attribute name="Type" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="HTTP"/>
          <xs:enumeration value="BT"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="Url" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DependenciesType">
    <xs:sequence>
      <xs:element name="Dll" type="DllType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DllType">
    <xs:sequence>
      <xs:element name="CustomData" type="DllCustomDataType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="ID" type="xs:string"/>
    <xs:attribute name="Name" type="xs:string" use="required"/>
    <xs:attribute name="Version" type="xs:string"/>
