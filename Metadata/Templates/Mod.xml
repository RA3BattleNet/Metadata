<?xml version="1.0" encoding="UTF-8"?>
<!-- 脚手架：复制到 mods/<name>/ 后改 ID/路径，再挂到 mods.xml。不参与构建语义。 -->
<Metadata>
  <Image ID="mod-icon-64px" Source="images/icon-64px.png" />

  <Mod ID="YourMod">
    <CurrentVersion>1.0.0</CurrentVersion>
    <Icon>mod-icon-64px</Icon>
    <Style>
      <Logo Width="400" Position="BottomLeft" OffsetX="24" OffsetY="-24">mod-icon-64px</Logo>
      <Controls>
        <PrimaryLabel>
          <Color>#FFFFFF</Color>
          <FontSize>18</FontSize>
          <FontWeight>700</FontWeight>
        </PrimaryLabel>
        <SecondaryLabel>
          <Color>#AAAAAA</Color>
          <FontSize>14</FontSize>
        </SecondaryLabel>
        <PrimaryButton>
          <BorderColor Format="ARGB">#FF000000</BorderColor>
          <BorderWidth>1</BorderWidth>
          <BackgroundColor>#EEEEEE</BackgroundColor>
          <Color>#151515</Color>
          <FontSize>16</FontSize>
          <FontWeight>700</FontWeight>
          <Hover>
            <BackgroundColor>#FFFFFF</BackgroundColor>
          </Hover>
          <Active>
            <BackgroundColor>#CCCCCC</BackgroundColor>
          </Active>
        </PrimaryButton>
        <SecondaryButton>
          <BorderColor>#333333</BorderColor>
          <BorderWidth>1</BorderWidth>
          <BackgroundColor>#18181880</BackgroundColor>
          <Color>#CCCCCC</Color>
          <Hover>
            <Color>#FFFFFF</Color>
          </Hover>
          <Active>
            <BackgroundColor>#303030CC</BackgroundColor>
          </Active>
        </SecondaryButton>
      </Controls>
      <Background Random="false">
        <Image>mod-icon-64px</Image>
        <Color>#000000CC</Color>
        <SecondaryColor>#191919E6</SecondaryColor>
      </Background>
    </Style>
    <Packages>
      <Package Version="1.0.0">
        <ReleaseDate>2026-01-01</ReleaseDate>
        <Manifest>manifest-100</Manifest>
      </Package>
    </Packages>
    <!-- 新闻与版本独立，简介可省略；取消注释前在顶部登记两份 Markdown ID，并填写实际日期与正文。
    <Posts>
      <Post DateTime="2026-10-02T00:00:00+08:00">
        <Titles>
          <Title Language="zh-CN">版本更新 1.9.9.11</Title>
          <Title Language="en-US">Update 1.9.9.11</Title>
        </Titles>
        <Descriptions>
          <Description Language="zh-CN">初版测试。</Description>
          <Description Language="en-US">Initial test.</Description>
        </Descriptions>
        <Contents>
          <Content Language="zh-CN">news-zh-1.9.9.11</Content>
          <Content Language="en-US">news-en-1.9.9.11</Content>
        </Contents>
      </Post>
    </Posts>
    -->
    <!-- 取消注释前替换成真实网址；Languages 省略时所有语言可见，名称缺少精确翻译时取第一条。
    <Links>
      <Link Url="https://example.com/" Languages="zh en">
        <Icon>mod-icon-64px</Icon>
        <DisplayName Language="zh-CN">官方网站</DisplayName>
        <DisplayName Language="en-US">Official website</DisplayName>
      </Link>
      <Link Url="https://example.com/wiki">
        <DisplayName Language="zh-CN">资料站</DisplayName>
        <DisplayName Language="en-US">Wiki</DisplayName>
      </Link>
    </Links>
    -->
    <!-- 通用模组设置定义：仅支持 Boolean（布尔）与 Choice（单选枚举）；
         ID 是所属 Mod 内的局部 ID，不含全根资源前缀；动态文案请使用标准主语言族代号（如 zh、en）。
         注意：Settings 节点在 XML 结构中必须作为 Mod 节点的最后一个子元素。示例：
    <Settings>
      <Boolean ID="hd-shadow" Default="false">
        <DisplayName Language="zh">高清阴影</DisplayName>
        <DisplayName Language="en">High-Res Shadows</DisplayName>
        <Description Language="zh">启用更高分辨率的实时地面阴影</Description>
        <Description Language="en">Enable higher resolution shadows</Description>
      </Boolean>
      <Choice ID="mod-language" Default="chs">
        <DisplayName Language="zh">模组语言</DisplayName>
        <DisplayName Language="en">Mod Language</DisplayName>
        <Option Value="chs">
          <DisplayName Language="zh">简体中文</DisplayName>
          <DisplayName Language="en">Simplified Chinese</DisplayName>
        </Option>
        <Option Value="en">
          <DisplayName Language="zh">英语 (English)</DisplayName>
          <DisplayName Language="en">English</DisplayName>
        </Option>
      </Choice>
    </Settings>
    -->
  </Mod>

  <Manifest ID="manifest-100">
    <File Hash="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA">
      <FileName>placeholder.bin</FileName>
      <RelativePath>/</RelativePath>
      <KindOf>MOD;</KindOf>
    </File>
    <!-- 依赖 DLL 列表：ID 为当前清单内的局部唯一 ID（供注入与设置动作引用）；Name 为实际文件名；
         Hash 请依据清单声明的 HashAlgorithm 填写真实计算值；
         Protocol 仅在需要被注入时显式声明（如 lyi-create-process、easyhook）；CustomData 目前仅支持 utf8/log-file。示例：
    <Dependencies>
      <Dll ID="lua-bridge" Name="RA3LuaBridge.dll" Hash="0D49B9A0" Protocol="lyi-create-process" />
      <Dll ID="crates-hook" Name="ARCratesDll.dll" Hash="真实CRC32C" Protocol="easyhook">
        <CustomData Encoding="utf8">
          <RuntimeValue Name="log-file" />
        </CustomData>
      </Dll>
    </Dependencies>
    -->
    <!-- 显式注入动作集合：凡是声明了 Dll ID 或在设置中包含 InjectDll 的新清单，都必须显式写出 Injection 节点；若无无条件动作，请写空节点 <Injection />。示例：
    <Injection>
      <RequireDll Ref="lyi" />
      <InjectDll Ref="lua-bridge" />
    </Injection>
    -->
    <!-- 版本设置绑定：一律使用 SettingRef 及其 Ref 属性引用 Mod 级已经定义的设置 ID，不可在此处重新定义设置。示例：
    <Settings>
      <SettingRef Ref="mod-language">
        <MountLanguage />
      </SettingRef>
      <SettingRef Ref="hd-shadow">
        <MountPackage Name="hd-shadow" />
      </SettingRef>
    </Settings>
    -->
  </Manifest>
</Metadata>
