<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Desktop NuGet：仅主包（解析 + 核心 Build），不含 Imaging/SkiaSharp -->
    <IsPackable>true</IsPackable>
    <PackageId>Ra3.BattleNet.Metadata</PackageId>
    <Version>1.0.0</Version>
    <Description>RA3 BattleNet metadata parse/query and pure-managed core build (no Imaging/WebP).</Description>
    <Authors>RA3BattleNet</Authors>
  </PropertyGroup>

</Project>
